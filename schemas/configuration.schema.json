{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fgilde/LibMentor/schemas/configuration.schema.json",
  "title": "LibMentor configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "version", "repository"],
  "properties": {
    "schemaVersion": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"},
    "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
    "revision": {"type": "string", "minLength": 1},
    "baseUrl": {"type": ["string", "null"], "format": "uri"},
    "output": {"type": "string", "default": ".libmentor"},
    "documents": {"$ref": "#/$defs/strings"},
    "sources": {"$ref": "#/$defs/strings"},
    "xmlDocumentation": {"$ref": "#/$defs/strings"},
    "typeDoc": {"$ref": "#/$defs/strings"},
    "exclude": {"$ref": "#/$defs/strings"},
    "examples": {"$ref": "#/$defs/strings"},
    "guidance": {"$ref": "#/$defs/strings"},
    "packages": {"$ref": "#/$defs/strings"}
  },
  "$defs": {"strings": {"type": "array", "items": {"type": "string"}}}
}
