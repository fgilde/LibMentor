{
  "schemaVersion": 1,
  "name": "LibMentor",
  "description": "Generate versioned AI documentation and agent skills for libraries.",
  "version": "0.1.1",
  "repository": "https://github.com/fgilde/LibMentor",
  "revision": "main",
  "baseUrl": "https://fgilde.github.io/LibMentor/ai",
  "output": ".libmentor",
  "documents": [
    "README.md",
    "CHANGELOG.md",
    "docs/**/*.md"
  ],
  "sources": [
    "src/**/*.cs"
  ],
  "exclude": [],
  "examples": [
    "examples/ExampleLibrary/ExampleLibrary.csproj"
  ],
  "packages": [
    "LibMentor"
  ],
  "guidance": [
    "Keep extraction evidence and source provenance when adding exporters."
  ]
}
